{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://situations-cut-retain-searching.trycloudflare.com/api/$1"
    },
    {
      "source": "/vapi/(.*)",
      "destination": "https://situations-cut-retain-searching.trycloudflare.com/vapi/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
